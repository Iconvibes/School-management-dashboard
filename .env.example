# MongoDB connection string (Mongoose)
# If omitted, Edutrack runs in DEMO MODE with in-memory storage.
MONGODB_URI=mongodb://127.0.0.1:27017/edutrack

# Seed the demo school (Greenfield International School + demo accounts) at
# boot. Production defaults to OFF — a fresh start has NO schools, and the
# first registered user becomes the first school's admin.
#   0|false  → never seed (production default)
#   1|true   → always seed (dev/test convenience)
#   unset    → seed unless NODE_ENV=production
# SEED_DEMO_SCHOOL=0

# Secret used to sign JWTs. Change in production!
JWT_SECRET=change-me-to-a-long-random-string

# Master key for field-level encryption at rest (AES-256-GCM). PII fields
# (email, phone) are stored encrypted in the database/snapshot; two keys are
# HKDF-derived from this one (AES + blind-index HMAC). Generate with:
#   openssl rand -hex 32
# If omitted, a deterministic DEV fallback is used (fine for demo, never prod).
DATA_ENC_KEY=change-me-to-64-hex-chars

# Comma-separated list of subjects for the grading matrix (optional override)
# EDUTRACK_SUBJECTS=Mathematics,English Language,Physics,Chemistry,Biology

# Hour (0-23, server-local) the daily timetable-conflict scan runs. Driven by
# the background job in src/instrumentation.js — NOT by dashboard loads.
# CONFLICT_SCAN_HOUR=2

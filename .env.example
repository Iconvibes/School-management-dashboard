# ===== EduTrack — scaled deployment env =====
# Copy to .env and fill in. NEVER commit real secrets.

# --- Database ---
# Demo mode runs when this is ABSENT (in-memory file store — dev only).
# Production MUST set this.
MONGODB_URI=mongodb+srv://<user>:<pass>@cluster0.xxxxx.mongodb.net/edutrack
# Connections per app instance. 25–50 keeps N instances inside Mongo's budget.
MONGODB_POOL_SIZE=25

# --- Redis (REQUIRED in production — the server refuses to boot without it) ---
# Shared rate-limit buckets, hard lockouts, and the auth/dashboard/timetable
# caches all depend on it (traffic audit §6). Fail-fast boot check in
# src/instrumentation.js.
REDIS_URL=redis://redis:6379
# Cache driver: default is "off" without REDIS_URL; set CACHE_MODE=memory to
# demo the auth-snapshot + dashboard-stats + timetable caches locally (dev only).
CACHE_MODE=

# --- Bot protection (Cloudflare Turnstile — optional; recommended for 08:00) ---
# Set BOTH to enforce Turnstile on login + register. Unset = widget hidden,
# verification skipped (demo/dev). The site key is public (shipped to the
# browser); the secret stays server-side. https://dash.cloudflare.com/turnstile
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# --- Auth ---
# Mandatory. The dev fallback is forgeable in production.
JWT_SECRET=generate-with: openssl rand -base64 48

# --- PII encryption at rest (REQUIRED in production — boot fails without it) ---
# Seeds the AES-256-GCM key that encrypts emails/phones; without it the app
# falls back to a KNOWN dev key (a leaked DB would decrypt PII). ESCROW this
# — losing it makes stored PII unreadable (docs/disaster-recovery.md).
DATA_ENC_KEY=generate-with: openssl rand -base64 32

# --- Jobs ---
# Exactly ONE app replica runs background jobs (conflict scan, sweeper).
# The rest must set this to "none".
RUN_JOBS=primary

# --- Login queue (worst-case 300k+ fresh logins; optional for day one) ---
# When set, POST /api/auth/login enqueues bcrypt verification to BullMQ
# workers instead of comparing inline. See EduTrack-Traffic-Audit.md §6.5.
QUEUE_REDIS_URL=

# --- Observability ---
SENTRY_DSN=
SENTRY_AUTH_TOKEN=
# Slow-query threshold in ms (mongoose plugin in src/lib/db.js).
MONGO_SLOW_QUERY_MS=200

# --- Email delivery (optional — the app works without it) ---
# When set, fee reminders and payment notifications are sent as real emails
# via SMTP. Without these, notifications stay in the in-app inbox only.
# Example for Gmail: SMTP_HOST=smtp.gmail.com SMTP_PORT=587 SMTP_USER=you@gmail.com SMTP_PASS=your-app-password
SMTP_HOST=
SMTP_PORT=
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
SMTP_SECURE=
# --- Performance knobs ---
UV_THREADPOOL_SIZE=8
# Notification poll interval in ms (currently 30000 in NotificationsBell.js).

# ===== EduTrack — scaled deployment env =====
# Copy to .env and fill in. NEVER commit real secrets.

# --- Database ---
# Demo mode runs when this is ABSENT (in-memory file store — dev only).
# Production MUST set this.
MONGODB_URI=mongodb+srv://<user>:<pass>@cluster0.xxxxx.mongodb.net/edutrack
# Connections per app instance. 25–50 keeps N instances inside Mongo's budget.
MONGODB_POOL_SIZE=25

# --- Redis (REQUIRED for >1 app instance) ---
REDIS_URL=redis://redis:6379
# Cache driver: default is "off" without REDIS_URL; set CACHE_MODE=memory to
# demo the auth-snapshot + dashboard-stats caches locally (dev only).
CACHE_MODE=

# --- Auth ---
# Mandatory. The dev fallback is forgeable in production.
JWT_SECRET=generate-with: openssl rand -base64 48

# --- Jobs ---
# Exactly ONE app replica runs background jobs (conflict scan, sweeper).
# The rest must set this to "none".
RUN_JOBS=primary

# --- Login queue (worst-case 300k+ fresh logins; optional for day one) ---
# When set, POST /api/auth/login enqueues bcrypt verification to BullMQ
# workers instead of comparing inline. See EduTrack-Traffic-Audit.md §6.5.
QUEUE_REDIS_URL=

# --- Observability ---
SENTRY_DSN=
SENTRY_AUTH_TOKEN=
# Slow-query threshold in ms (mongoose plugin in src/lib/db.js).
MONGO_SLOW_QUERY_MS=200

# --- Performance knobs ---
UV_THREADPOOL_SIZE=8
# Notification poll interval in ms (currently 30000 in NotificationsBell.js).

# MongoDB connection string (Mongoose)
# If omitted, Edutrack runs in DEMO MODE with seeded in-memory data.
MONGODB_URI=mongodb://127.0.0.1:27017/edutrack

# Secret used to sign JWTs. Change in production!
JWT_SECRET=change-me-to-a-long-random-string

# Comma-separated list of subjects for the grading matrix (optional override)
# EDUTRACK_SUBJECTS=Mathematics,English Language,Physics,Chemistry,Biology
